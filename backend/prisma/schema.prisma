// Render deployment uses Postgres (DATABASE_URL comes from render.yaml's
// `fromDatabase` binding). For local dev without Postgres, change
// `provider` back to "sqlite", point DATABASE_URL at a local file (see
// backend/.env.example), and run `npm run prisma:migrate` again — this
// requires regenerating backend/prisma/migrations for the sqlite provider,
// since migration SQL is provider-specific — see README.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Caches to respect Nominatim/Overpass usage policy (rate limits, no
// hammering shared public infra) — see src/geocode.ts / src/overpass.ts.
model GeocodeCache {
  id         Int      @id @default(autoincrement())
  query      String   @unique
  resultJson String
  fetchedAt  DateTime @default(now())
}

model OverpassCache {
  id         Int      @id @default(autoincrement())
  cacheKey   String   @unique
  resultJson String
  fetchedAt  DateTime @default(now())
}
